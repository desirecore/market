        "path": "skills/in-progress/chief-of-staff",
        "oldDescription": "Pursue a long-running goal in a single session by co-ordinating subagents.",
        "newDescription": "Delegate the work to fresh subagents and remember what it taught you in a dated wiki, so the next session picks up the thread.",
        "newFrontmatterSha256": "a7e51a294e73a8b36aa90d1d90ad281e397bf7b5e9cbc544469b52de09409242",
        "locales": {
          "zh-CN": {
